SECRET_COOKIE_PASSWORD=replace-with-a-long-random-secret
AD_CONFIG_ENCRYPTION_KEY=
KOMS_URL=
NEXT_ALLOWED_DEV_ORIGINS=

# Canonical public origin when running behind a reverse proxy (scheme + host + port).
APP_ORIGIN=
# Temporary first-run access: at least 32 random characters. Remove after AD setup.
SETUP_TOKEN=
# Set only if a trusted proxy overwrites this header and blocks direct backend access.
# X-Forwarded-For is deliberately unsupported. Leave empty if machine restriction is unused.
TRUSTED_CLIENT_IP_HEADER=
# Comma-separated exact HTTPS hosts permitted for forms, including redirect destinations.
FORM_ALLOWED_HOSTS=www.rcr.ac.uk,rcr.ac.uk
# Optional writable external directory for runtime JSON configuration and consent-forms.json.
CONFIG_DIR=
# Privacy-filtered feedback diagnostics; no patient values, credentials, or paths are recorded.
FEEDBACK_LOG_ENABLED=false
FEEDBACK_LOG_DIR=
NEXT_TELEMETRY_DISABLED=1
